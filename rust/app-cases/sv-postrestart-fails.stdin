{"system": "sys", "steps": [{"op": "spawn", "name": "p", "as": "p", "behavior": {"kind": "log", "throw-on": "boom", "keep-children": true, "throw-in-post-restart": true}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "k", "as": "k", "behavior": {"kind": "log"}}}, {"op": "await-events", "target": "k", "count": 1}, {"op": "tell", "ref": "p", "msg": "boom"}, {"op": "await-events", "target": "k", "count": 2}, {"op": "await-stopped", "ref": "k"}, {"op": "events-now", "target": "k"}, {"op": "events-now", "target": "p"}]}