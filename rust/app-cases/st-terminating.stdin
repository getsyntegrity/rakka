{"system": "sys", "steps": [{"op": "subscribe", "channel": "errors", "prefix": "handleChildTerminated", "as": "er"}, {"op": "spawn", "name": "top", "as": "top", "behavior": {"kind": "log", "supervisor": {"log-decisions": true, "decider": {"strategy": "stop", "boom": "restart"}}}}, {"op": "await-events", "target": "top", "count": 1}, {"op": "do", "ref": "top", "cmd": {"c": "spawn-child", "name": "p", "as": "p", "behavior": {"kind": "log", "supervisor": {"log-calls": true, "throw-on-call": 1}}}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c", "as": "c", "behavior": {"kind": "log", "throw-on": "boom"}}}, {"op": "await-events", "target": "c", "count": 1}, {"op": "stop", "ref": "p"}, {"op": "await-stopped", "ref": "p"}, {"op": "await-events", "target": "top", "count": 1}, {"op": "events-now", "target": "er"}, {"op": "events-now", "target": "top"}, {"op": "events-now", "target": "p"}]}