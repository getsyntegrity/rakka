{"system": "sys", "guardian-strategy": "org.apache.pekko.actor.DefaultSupervisorStrategy", "steps": [{"op": "spawn", "name": "boss", "as": "boss", "behavior": {"kind": "log", "supervisor": {"match": [["java.lang.Exception", "restart"]]}, "keep-children": true, "post-restart-without-pre-start": true}}, {"op": "await-events", "target": "boss", "count": 1}, {"op": "do", "ref": "boss", "cmd": {"c": "spawn-child", "name": "m", "as": "m", "behavior": {"kind": "log", "supervisor": {"strategy": "all-for-one", "match": [], "log-decisions": true}, "keep-children": true, "post-restart-without-pre-start": true}}}, {"op": "await-events", "target": "m", "count": 1}, {"op": "do", "ref": "m", "cmd": {"c": "spawn-child", "name": "w1", "as": "w1", "behavior": {"kind": "log", "keep-children": true, "post-restart-without-pre-start": true}}}, {"op": "await-events", "target": "w1", "count": 1}, {"op": "do", "ref": "m", "cmd": {"c": "spawn-child", "name": "w2", "as": "w2", "behavior": {"kind": "log", "keep-children": true, "post-restart-without-pre-start": true}}}, {"op": "await-events", "target": "w2", "count": 1}, {"op": "do", "ref": "m", "cmd": {"c": "spawn-child", "name": "w3", "as": "w3", "behavior": {"kind": "log", "keep-children": true, "post-restart-without-pre-start": true}}}, {"op": "await-events", "target": "w3", "count": 1}, {"op": "tell", "ref": "w1", "msg": {"special": "Kill"}}, {"op": "await-life", "count": 13, "before": [["m:post-restart", "w1:post-restart"], ["m:post-restart", "w2:post-restart"], ["m:post-restart", "w3:post-restart"]]}, {"op": "await-events", "target": "m", "count": 3}, {"op": "await-quiet", "target": "m", "count": 4, "ms": 200}, {"op": "await-events", "target": "w1", "count": 3}, {"op": "await-quiet", "target": "w1", "count": 3, "ms": 200}, {"op": "await-events", "target": "w2", "count": 3}, {"op": "await-quiet", "target": "w2", "count": 3, "ms": 200}, {"op": "await-events", "target": "w3", "count": 3}, {"op": "await-quiet", "target": "w3", "count": 3, "