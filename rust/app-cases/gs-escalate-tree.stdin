{"system": "sys", "guardian-strategy": "pilot.GuardianStrategies$Escalate", "steps": [{"op": "spawn", "name": "a", "as": "a", "behavior": {"kind": "log", "throw-on": ["hello"]}}, {"op": "await-events", "target": "a", "count": 1}, {"op": "do", "ref": "a", "cmd": {"c": "spawn-child", "name": "c", "as": "c", "behavior": {"kind": "log"}}}, {"op": "await-events", "target": "c", "count": 1}, {"op": "spawn", "name": "b", "as": "b", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "b", "count": 1}, {"op": "tell", "ref": "a", "msg": "hello"}, {"op": "await-system-terminated"}, {"op": "await-life", "count": 6, "before": [["c:post-stop", "a:post-stop"]]}, {"op": "events-now", "target": "a"}, {"op": "events-now", "target": "b"}, {"op": "events-now", "target": "c"}]}