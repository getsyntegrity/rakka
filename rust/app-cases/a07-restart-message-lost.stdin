{"system": "sys", "steps": [{"op": "subscribe", "channel": "dead-letters", "as": "dl"}, {"op": "spawn", "name": "p", "as": "p", "behavior": {"kind": "log", "supervisor": {"decider": {"bres": "resume", "brst": "restart", "bstp": "stop"}}}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c", "as": "c", "behavior": {"kind": "log", "numbered": true, "throw-on": ["bres", "brst", "bstp", "other"]}}}, {"op": "tell", "ref": "c", "msg": "brst"}, {"op": "tell", "ref": "c", "msg": "x"}, {"op": "await-events", "target": "c", "count": 7}, {"op": "do", "ref": "c", "cmd": {"c": "children"}}, {"op": "events-now", "target": "dl"}]}