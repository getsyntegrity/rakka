{"system": "sys", "steps": [{"op": "subscribe", "channel": "dead-letters", "as": "dl"}, {"op": "spawn", "name": "w", "as": "w", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "w", "count": 1}, {"op": "spawn", "name": "p", "as": "p", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c", "as": "c", "behavior": {"kind": "log"}}}, {"op": "await-life", "count": 3, "before": []}, {"op": "do", "ref": "w", "cmd": {"c": "watch", "target": "c"}}, {"op": "do", "ref": "w", "cmd": {"c": "watch", "target": "p"}}, {"op": "stop", "ref": "p"}, {"op": "await-life", "count": 7, "before": [["c:post-stop", "p:post-stop"]]}, {"op": "tell", "ref": "c", "msg": "late-c"}, {"op": "tell", "ref": "p", "msg": "late-p"}, {"op": "await-events", "target": "dl", "count": 2}]}