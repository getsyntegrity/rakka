{"system": "sys", "steps": [{"op": "subscribe", "channel": "logs", "prefix": "", "as": "lg"}, {"op": "spawn", "name": "p", "as": "p", "behavior": {"kind": "log", "log-sender": true, "supervisor": {"log-decisions": true, "decider": {}}}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c", "as": "c", "behavior": {"kind": "log"}}}, {"op": "await-events", "target": "c", "count": 1}, {"op": "tell", "ref": "c", "msg": {"special": "Kill"}}, {"op": "await-stopped", "ref": "c"}, {"op": "await-events", "target": "p", "count": 2}, {"op": "await-events", "target": "lg", "count": 1}, {"op": "stop", "ref": "p"}, {"op": "await-stopped", "ref": "p"}, {"op": "await-quiet", "target": "lg", "count": 1, "ms": 300}, {"op": "events-now", "target": "p"}, {"op": "events-now", "target": "c"}]}