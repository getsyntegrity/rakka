{"system": "sys", "guardian-strategy": "org.apache.pekko.actor.DefaultSupervisorStrategy", "steps": [{"op": "spawn", "name": "g", "as": "g", "behavior": {"kind": "log", "supervisor": {"decider": {"esc": "resume"}, "hold": "H"}}}, {"op": "await-events", "target": "g", "count": 1}, {"op": "do", "ref": "g", "cmd": {"c": "spawn-child", "name": "p", "as": "p", "behavior": {"kind": "log", "supervisor": {"decider": {"esc": "escalate"}}}}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c", "as": "c", "behavior": {"kind": "log", "throw-on": ["esc"]}}}, {"op": "await-events", "target": "c", "count": 1}, {"op": "tell", "ref": "c", "msg": "esc"}, {"op": "tell", "ref": "c", "msg": "q"}, {"op": "await-life", "count": 4, "before": []}, {"op": "tell", "ref": "p", "msg": "pm"}, {"op": "await-quiet", "target": "c", "count": 2, "ms": 200}, {"op": "await-quiet", "target": "p", "count": 1, "ms": 200}, {"op": "open-hold", "hold": "H"}, {"op": "await-events", "target": "c", "count": 3}, {"op": "await-events", "target": "p", "count": 2}]}