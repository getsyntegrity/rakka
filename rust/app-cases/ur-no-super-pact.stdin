{"system": "sys", "steps": [{"op": "spawn", "name": "p", "as": "p", "behavior": {"kind": "log", "throw-on": "boom", "stop-without-unwatch": true, "ignore-terminated": true}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c", "as": "c", "behavior": {"kind": "log"}}}, {"op": "await-events", "target": "c", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "watch", "target": "c"}}, {"op": "tell", "ref": "p", "msg": "boom"}, {"op": "await-events", "target": "p", "count": 6}, {"op": "await-stopped", "ref": "p"}, {"op": "events-now", "target": "p"}]}