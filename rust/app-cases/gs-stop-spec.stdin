{"system": "sys", "guardian-strategy": "org.apache.pekko.actor.StoppingSupervisorStrategy", "steps": [{"op": "subscribe", "channel": "logs", "prefix": "hello", "as": "lg"}, {"op": "spawn", "name": "w", "as": "w", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "w", "count": 1}, {"op": "spawn", "name": "a", "as": "a", "behavior": {"kind": "log", "throw-on": ["hello"]}}, {"op": "await-events", "target": "a", "count": 1}, {"op": "do", "ref": "w", "cmd": {"c": "watch", "target": "a"}}, {"op": "tell", "ref": "a", "msg": "hello"}, {"op": "await-events", "target": "w", "count": 2}, {"op": "await-events", "target": "lg", "count": 1}, {"op": "await-events", "target": "a", "count": 3}, {"op": "await-quiet", "target": "lg", "count": 1, "ms": 200}, {"op": "await-quiet", "target": "a", "count": 3, "ms": 200}, {"op": "tell", "ref": "w", "msg": "next"}, {"op": "await-events", "target": "w", "count": 3}, {"op": "events-now", "target": "w"}]}