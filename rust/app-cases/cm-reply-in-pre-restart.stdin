{"system": "sys", "steps": [{"op": "spawn", "name": "probe", "as": "probe", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "probe", "count": 1}, {"op": "spawn", "name": "g", "as": "g", "behavior": {"kind": "log", "supervisor": {"strategy": "all-for-one", "max": 5, "decider": {"test": "restart"}}}}, {"op": "await-events", "target": "g", "count": 1}, {"op": "do", "ref": "g", "cmd": {"c": "spawn-child", "name": "p", "as": "p", "behavior": {"kind": "log", "throw-on": "test", "pre-restart-reply": "failure1", "keep-children": true, "log-sender": true}}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "tell", "ref": "p", "msg": "test", "from": "probe"}, {"op": "await-events", "target": "probe", "count": 2}, {"op": "await-events", "target": "p", "count": 5}, {"op": "events-now", "target": "probe"}, {"op": "events-now", "target": "p"}]}