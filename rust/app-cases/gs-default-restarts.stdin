{"system": "sys", "guardian-strategy": "org.apache.pekko.actor.DefaultSupervisorStrategy", "steps": [{"op": "subscribe", "channel": "logs", "prefix": "hello", "as": "lg"}, {"op": "spawn", "name": "a", "as": "a", "behavior": {"kind": "log", "throw-on": ["hello"]}}, {"op": "await-events", "target": "a", "count": 1}, {"op": "tell", "ref": "a", "msg": "hello"}, {"op": "await-events", "target": "a", "count": 6}, {"op": "await-events", "target": "lg", "count": 1}, {"op": "await-quiet", "target": "lg", "count": 1, "ms": 200}, {"op": "tell", "ref": "a", "msg": "next"}, {"op": "await-events", "target": "a", "count": 7}, {"op": "events-now", "target": "a"}]}