{"system": "sys", "guardian-strategy": "org.apache.pekko.actor.StoppingSupervisorStrategy", "steps": [{"op": "spawn", "name": "a", "as": "a", "behavior": {"kind": "log", "throw-on": ["hello"]}}, {"op": "await-events", "target": "a", "count": 1}, {"op": "do", "ref": "a", "cmd": {"c": "spawn-child", "name": "c", "as": "c", "behavior": {"kind": "log"}}}, {"op": "await-events", "target": "c", "count": 1}, {"op": "spawn", "name": "b", "as": "b", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "b", "count": 1}, {"op": "do", "ref": "b", "cmd": {"c": "watch", "target": "a"}}, {"op": "tell", "ref": "a", "msg": "hello"}, {"op": "await-events", "target": "b", "count": 2}, {"op": "await-life", "count": 6, "before": [["c:post-stop", "a:post-stop"], ["a:post-stop", "b:terminated:a"]]}, {"op": "events-now", "target": "c"}, {"op": "tell", "ref": "b", "msg": "next"}, {"op": "await-events", "target": "b", "count": 3}, {"op": "events-now", "target": "b"}]}