{"system": "sys", "guardian-strategy": "org.apache.pekko.actor.StoppingSupervisorStrategy", "steps": [{"op": "spawn", "name": "a", "as": "a", "behavior": {"kind": "log", "throw-class": {"hello": "error"}}}, {"op": "await-events", "target": "a", "count": 1}, {"op": "tell", "ref": "a", "msg": "hello"}, {"op": "await-system-terminated"}, {"op": "events-now", "target": "a"}]}