{"system": "sys", "guardian-strategy": "org.apache.pekko.actor.DefaultSupervisorStrategy", "steps": [{"op": "spawn", "name": "w", "as": "w", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "w", "count": 1}, {"op": "spawn", "name": "a", "as": "a", "behavior": {"kind": "log", "throw-on": []}}, {"op": "await-events", "target": "a", "count": 1}, {"op": "do", "ref": "w", "cmd": {"c": "watch", "target": "a"}}, {"op": "tell", "ref": "a", "msg": {"special": "Kill"}}, {"op": "await-events", "target": "w", "count": 2}, {"op": "await-events", "target": "a", "count": 2}, {"op": "events-now", "target": "a"}]}