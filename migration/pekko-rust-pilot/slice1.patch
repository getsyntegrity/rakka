--- /dev/null
+++ b/rust-port/src/lib.rs
@@ -0,0 +1,20 @@
+//! Rust port of the Apache Pekko 2.0.0 actor model (Classic + Typed), built slice by slice.
+//!
+//! Slice 1 (this crate so far): `ActorPath.fromString` and the `java.net.URI` behaviour it
+//! depends on. Strings are modelled as UTF-16 code-unit vectors (`Vec<u16>`) because the
+//! reference runs on the JVM and its observable behaviour (lone surrogates, positions,
+//! `Character` classes) is defined on UTF-16.
+
+pub mod actor_path;
+pub mod jdk_int;
+pub mod jdk_tables;
+pub mod jdk_uri;
+pub mod json;
+
+/// UTF-16 string, the representation of a Java `String`.
+pub type JStr = Vec<u16>;
+
+/// Builds a [`JStr`] from a Rust string.
+pub fn jstr(s: &str) -> JStr {
+    s.encode_utf16().collect()
+}
diff --git a/rust-port/src/main.rs b/rust-port/src/main.rs
index e7a11a9..f658dce 100644
--- a/rust-port/src/main.rs
+++ b/rust-port/src/main.rs
@@ -1,3 +1,112 @@
-fn main() {
-    println!("Hello, world!");
+//! CLI mirroring the Java oracle (`oracle/src/main/java/pilot/Cli.java`):
+//!
+//! ```text
+//! rust-port path-from-string         stdin = one JSON string literal  -> one JSON result
+//! rust-port path-from-string-lines   stdin = one JSON string literal per line -> one JSON result per line
+//! ```
+
+use std::io::{Read, Write};
+use std::process::ExitCode;
+
+use rust_port::actor_path::ActorPath;
+use rust_port::json::{parse_str, write_str};
+
+fn path_from_string(s: &[u16]) -> String {
+    let mut out = String::new();
+    match ActorPath::from_string(s) {
+        Ok(p) => {
+            let a = &p.address;
+            out.push_str("{\"ok\":true,\"toString\":");
+            write_str(&mut out, &p.to_jstring());
+            out.push_str(",\"name\":");
+            write_str(&mut out, &p.name());
+            out.push_str(",\"elements\":[");
+            for (i, e) in p.elements().iter().enumerate() {
+                if i > 0 {
+                    out.push(',');
+                }
+                write_str(&mut out, e);
+            }
+            out.push_str(&format!("],\"uid\":{}", p.uid));
+            out.push_str(",\"toStringWithoutAddress\":");
+            write_str(&mut out, &p.to_string_without_address());
+            out.push_str(",\"toSerializationFormat\":");
+            write_str(&mut out, &p.to_serialization_format());
+            out.push_str(",\"address\":{\"protocol\":");
+            write_str(&mut out, &a.protocol);
+            out.push_str(",\"system\":");
+            write_str(&mut out, &a.system);
+            out.push_str(",\"host\":");
+            match &a.host {
+                Some(h) => write_str(&mut out, h),
+                None => out.push_str("null"),
+            }
+            out.push_str(",\"port\":");
+            match a.port {
+                Some(p) => out.push_str(&p.to_string()),
+                None => out.push_str("null"),
+            }
+            out.push_str(",\"toString\":");
+            write_str(&mut out, &a.to_jstring());
+            out.push_str("}}");
+        }
+        Err(f) => {
+            out.push_str("{\"ok\":false,\"exception\":");
+            write_str(&mut out, &f.exception.encode_utf16().collect::<Vec<_>>());
+            out.push_str(",\"message\":");
+            write_str(&mut out, &f.message);
+            out.push('}');
+        }
+    }
+    out
+}
+
+fn usage() -> ExitCode {
+    eprintln!("usage: rust-port path-from-string | path-from-string-lines   (JSON string literal(s) on stdin)");
+    ExitCode::from(2)
+}
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if args.len() != 1 {
+        return usage();
+    }
+    let mut input = String::new();
+    if std::io::stdin().read_to_string(&mut input).is_err() {
+        eprintln!("stdin is not valid UTF-8");
+        return ExitCode::from(2);
+    }
+    let stdout = std::io::stdout();
+    let mut out = stdout.lock();
+    match args[0].as_str() {
+        "path-from-string" => {
+            let lit = input.strip_suffix('\n').unwrap_or(&input);
+            match parse_str(lit) {
+                Ok(s) => writeln!(out, "{}", path_from_string(&s)).ok(),
+                Err(e) => {
+                    eprintln!("{e}");
+                    return ExitCode::from(2);
+                }
+            };
+        }
+        "path-from-string-lines" => {
+            let mut buf = String::new();
+            for line in input.split('\n').filter(|l| !l.is_empty()) {
+                match parse_str(line) {
+                    Ok(s) => {
+                        buf.push_str(&path_from_string(&s));
+                        buf.push('\n');
+                    }
+                    Err(e) => {
+                        eprintln!("{e}");
+                        return ExitCode::from(2);
+                    }
+                }
+            }
+            out.write_all(buf.as_bytes()).ok();
+        }
+        _ => return usage(),
+    }
+    out.flush().ok();
+    ExitCode::SUCCESS
 }
