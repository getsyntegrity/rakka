+//! Unicode tables extracted from the reference JDK (17.0.21.0.3+0).
+//! GENERATED by tools/GenTables.java - do not edit by hand.
+
+/// Start code units of each run of 10 consecutive decimal digits (`Character.digit(c, 10)`), BMP only.
+pub const DIGIT_ZEROS: &[u16] = &[
+    0x0030, 0x0660, 0x06F0, 0x07C0, 0x0966, 0x09E6, 0x0A66, 0x0AE6,
+    0x0B66, 0x0BE6, 0x0C66, 0x0CE6, 0x0D66, 0x0DE6, 0x0E50, 0x0ED0,
+    0x0F20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80,
+    0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900,
+    0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10,
+];
+
+/// Inclusive ranges of `Character.isSpaceChar(c)` for code units above 0x80.
+pub const SPACE_CHAR_RANGES: &[(u16, u16)] = &[
+    (0x00A0, 0x00A0),
+    (0x1680, 0x1680),
+    (0x2000, 0x200A),
+    (0x2028, 0x2029),
+    (0x202F, 0x202F),
+    (0x205F, 0x205F),
+    (0x3000, 0x3000),
+];
+
+/// `Character.isISOControl(c)` above 0x80 is exactly this inclusive range (checked at generation).
+pub const ISO_CONTROL_HIGH: (u16, u16) = (0x0081, 0x009F);
