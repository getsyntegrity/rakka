+#!/usr/bin/env python3
+"""Proves the recorded replay can fail: replays deliberately broken copies of the Rust port.
+
+For each mutant it copies rust-port/ into a scratch dir (the real sources are never touched),
+applies one source edit, builds it, runs `rust-anything app replay --build <mutant binary>`, and
+requires a non-zero exit with at least one failing case. The per-mutant replay reports are kept in
+rust/divergence-reports/. Finally the unmodified port is replayed again as the control.
+
+  tools/check_divergence.py
+"""
+import difflib, os, re, shutil, subprocess, sys, tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+CRATE = os.path.join(ROOT, "rust-port")
+REPORTS = os.path.join(ROOT, "rust", "divergence-reports")
+CASES_REPORT = os.path.join(ROOT, "rust", "app-cases", "replay-report.md")
+
+# name -> (file, old, new, why it is a realistic bug)
+MUTANTS = {
+    "utf8-lossy-decoder": (
+        "src/jdk_uri.rs",
+        "out.extend(decode_utf8_jdk(&bytes));",
+        "out.extend(String::from_utf8_lossy(&bytes).encode_utf16());",
+        "decode %XX user info with Rust's maximal-subpart UTF-8 replacement instead of the JDK's "
+        "(the real bug the differential fuzzer found while porting)",
+    ),
+    "drop-uid-in-serialization-format": (
+        "src/actor_path.rs",
+        "if self.uid != 0 {\n            s.push('#' as u16);",
+        "if false {\n            s.push('#' as u16);",
+        "toSerializationFormat forgets the #uid suffix",
+    ),
+}
+
+
+def sh(cmd, **kw):
+    return subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, **kw)
+
+
+def replay(binary):
+    return sh(["rust-anything", "app", "replay", ROOT, "--build", binary])
+
+
+def main():
+    os.makedirs(REPORTS, exist_ok=True)
+    scratch = tempfile.mkdtemp(prefix="pekko-mutants-")
+    ok = True
+    try:
+        for name, (rel, old, new, why) in MUTANTS.items():
+            work = os.path.join(scratch, name)
+            shutil.copytree(CRATE, work, ignore=shutil.ignore_patterns("target"))
+            path = os.path.join(work, rel)
+            src = open(path).read()
+            assert src.count(old) == 1, f"{name}: pattern must occur exactly once in {rel}"
+            open(path, "w").write(src.replace(old, new))
+            print(f"=== mutant {name}: {why}")
+            print("".join(difflib.unified_diff(src.splitlines(True), src.replace(old, new).splitlines(True),
+                                               f"a/rust-port/{rel}", f"b/rust-port/{rel}")))
+            b = sh(["cargo", "build", "--release", "--manifest-path", os.path.join(work, "Cargo.toml"),
+                    "--target-dir", os.path.join(scratch, "target-" + name)])
+            if b.returncode != 0:
+                print(b.stderr[-2000:]); sys.exit("mutant failed to build")
+            binary = os.path.join(scratch, "target-" + name, "release", "rust-port")
+            r = replay(binary)
+            shutil.copy(CASES_REPORT, os.path.join(REPORTS, f"replay-report-{name}.md"))
+            summary = [l for l in r.stdout.splitlines() if "cases passed" in l]
+            detected = r.returncode != 0
+            print(f"replay exit={r.returncode}  {summary[0] if summary else r.stdout.strip()}  -> "
+                  f"{'DETECTED' if detected else 'NOT DETECTED (bad)'}\n")
+            ok &= detected
+        c = replay(os.path.join(CRATE, "target", "release", "rust-port"))
+        csum = [l for l in c.stdout.splitlines() if "cases passed" in l]
+        print(f"=== control (unmodified rust-port): exit={c.returncode}  {csum[0] if csum else c.stdout.strip()}")
+        ok &= c.returncode == 0
+    finally:
+        shutil.rmtree(scratch, ignore_errors=True)
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    main()
