+def main():
+    out = os.path.join(ROOT, "cases", "path-from-string.jsonl")
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    names = [n for n, _ in CASES]
+    assert len(names) == len(set(names)), "duplicate case names"
+    with open(out, "w", encoding="ascii") as f:
+        for name, text in CASES:
+            lit = json.dumps(text, ensure_ascii=True)  # the JSON string literal the CLI reads on stdin
+            f.write(json.dumps({"name": name, "args": ["path-from-string"], "stdin": lit}, ensure_ascii=True) + "\n")
+    print(f"wrote {len(CASES)} cases to {os.path.relpath(out, ROOT)}")
