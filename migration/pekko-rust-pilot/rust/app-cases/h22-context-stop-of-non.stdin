{"system": "sys", "steps": [{"op": "spawn", "name": "a", "as": "a", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "a", "count": 1}, {"op": "spawn", "name": "b", "as": "b", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "b", "count": 1}, {"op": "await-life", "count": 2, "before": []}, {"op": "do", "ref": "a", "cmd": {"c": "stop", "target": "b"}}, {"op": "await-life", "count": 3, "before": [["b:pre-start", "b:post-stop"]]}, {"op": "do", "ref": "a", "cmd": {"c": "children"}}]}