{"system": "sys", "steps": [{"op": "spawn", "name": "p", "as": "p", "behavior": {"kind": "log"}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c1", "as": "c1", "behavior": {"kind": "log"}}}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c2", "as": "c2", "behavior": {"kind": "log"}}}, {"op": "do", "ref": "c1", "cmd": {"c": "spawn-child", "name": "g1", "as": "g1", "behavior": {"kind": "log"}}}, {"op": "do", "ref": "c1", "cmd": {"c": "spawn-child", "name": "g2", "as": "g2", "behavior": {"kind": "log"}}}, {"op": "await-life", "count": 5, "before": []}, {"op": "do", "ref": "p", "cmd": {"c": "stop", "target": "c1"}}, {"op": "await-life", "count": 8, "before": [["g1:post-stop", "c1:post-stop"], ["g2:post-stop", "c1:post-stop"]]}, {"op": "do", "ref": "c2", "cmd": {"c": "children"}}]}