{"system": "sys", "steps": [{"op": "spawn", "name": "p", "as": "p", "behavior": {"kind": "log", "supervisor": {"decider": {"bres": "resume", "brst": "restart", "bstp": "stop"}}}}, {"op": "await-events", "target": "p", "count": 1}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c1", "as": "c1", "behavior": {"kind": "log", "numbered": true, "throw-on": ["bres", "brst", "bstp", "other"]}}}, {"op": "do", "ref": "p", "cmd": {"c": "spawn-child", "name": "c2", "as": "c2", "behavior": {"kind": "log", "numbered": true, "throw-on": ["bres", "brst", "bstp", "other"]}}}, {"op": "do", "ref": "p", "cmd": {"c": "watch", "target": "c1"}}, {"op": "tell", "ref": "c1", "msg": "bstp"}, {"op": "await-events", "target": "p", "count": 2}, {"op": "do", "ref": "p", "cmd": {"c": "children"}}, {"op": "tell", "ref": "c2", "msg": "alive"}, {"op": "await-events", "target": "c2", "count": 2}]}